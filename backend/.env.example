NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/klantenportaal
# In productie met Supabase: DATABASE_URL = de "Transaction pooler"-string (poort 6543, ?pgbouncer=true),
# DIRECT_URL = de "Direct connection"-string (poort 5432). Lokaal mogen beide gelijk zijn.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/klantenportaal
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
